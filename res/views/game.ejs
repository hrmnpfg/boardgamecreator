<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="ie=edge">
<link rel="stylesheet" type="text/css" href="styles.css">
<script src="/socket.io/socket.io.js"></script>
<script>
        var socket = io();
        var roomid = '<%= room.room_ID %>';
        var userid = '<%= userid %>';
        socket.emit('join room',roomid);
        socket.on('board', function(data) {
            let pomi = document.getElementById("fstatus");
            pomi.innerHTML = data;
        });

</script>
<title>Document</title>
</head>
    <body class="container">
        <header>Boardgames</header>
        <text><%= username %></text>
            <form method="POST" id="commands" action="/game?room=<%= room.room_ID %>">
                <% if (room) { %>
                Type a command: <input type="text" name="command" id="command" required/>
                <button class="openedRoomsButton"> Wyślij </button>
                <p id="fstatus"></p>
            <% } %>
        </form>
        <div class="Grid">
            TODO add some scripts for generating board
        </div>
        <script>
            var form = document.getElementById("commands");
            form.addEventListener("submit", async function handleSubmit(event) {
                event.preventDefault();
                var status = document.getElementById("fstatus");
                var data = new FormData(event.target);
                var formDataString = new URLSearchParams(data).toString();

                try {
                    var res = await fetch(event.target.action, {
                        method: form.method,
                        body: formDataString,
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/x-www-form-urlencoded'
                        }
                    });

                    if (res.ok) {
                        const data2 = await res.json();

                        if (data2.redirect) {
                            window.location.href = data2.redirect;
                            return;
                        }

                        status.innerHTML = `Submited<br> Response: ${data2.resp}`;
                        form.reset()
                    } else {
                        const data = await res.json();
                        if (data.errors) {
                            status.textContent = data.errors.map(error => error.message).join(", ");
                        } else {
                            status.textContent = "sth wrong submit died with res.";
                        }
                    }
                }
                catch (error) {
                    status.innerHTML = "sth went wrong with submitting"
                }
                let napis=status.innerHTML;
                socket.emit('chat-message',napis,roomid,userid);
            });
        </script>
        <script src="/socket.io/socket.io.js"></script>
        <script>
            var socket = io();
        </script>
    </body>
</html>
